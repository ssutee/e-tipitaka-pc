<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Mac App Store (sandboxed) build.

  App Sandbox is mandatory for MAS. The app needs outbound network (account
  login + database/scripture downloads) and read-write to files the user picks
  (PDF export, .etz import/export).

  NOTE: the Developer ID exceptions (disable-library-validation,
  allow-unsigned-executable-memory) are intentionally ABSENT — they are
  generally rejected for MAS. Every bundled binary must therefore be signed
  with the Apple Distribution certificate (build_mas.sh does this). If review
  fails on library validation, that is the known PyInstaller/wxPython MAS
  friction point; see README.md.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
